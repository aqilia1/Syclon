end)

-- ===== HOLD =====
local function fireAll(t)
    local h=getHRP(); if not h or not t or not t.Parent then return end
    for _,d in ipairs(t:GetDescendants()) do
        if d:IsA("BasePart") then
            pcall(function() firetouchinterest(h,d,0); firetouchinterest(h,d,1) end)
            local cd=d:FindFirstChildOfClass("ClickDetector"); if cd then pcall(function() fireclickdetector(cd) end) end
        elseif d:IsA("ProximityPrompt") then pcall(function() fireproximityprompt(d) end)
        elseif d:IsA("ClickDetector") then pcall(function() fireclickdetector(d) end) end
    end
end
local function holdCollect(t)
    if not t or not t.Parent then return true end
    local h=getHRP(); if not h then return false end
    local t0=tick(); local last=tick()
    while tick()-t0<CFG.HOLD_DURATION do
        if S.killed or not S.running then return false end
        if not t.Parent then return true end
        fireAll(t)
        if tick()-last>CFG.HOLD_REPOSITION then
            local r=findRoot(t); if r and (h.Position-r.Position).Magnitude>6 then tpTo(r.CFrame) end
            last=tick()
        end
        task.wait(CFG.HOLD_TICK)
    end
    return (not t.Parent)
end

-- ===== SCAN =====
local lastCount=-1
local function rebuild()
    S.models={}; S.groups={}
    local we=Workspace:FindFirstChild("WorldEggs")
    if we then
        for _,obj in ipairs(we:GetDescendants()) do
            if obj:IsA("Model") then
                local r=findRoot(obj)
                if r then
                    local nm=getEggName(obj)
                    S.models[obj]={name=nm,root=r}
                    S.groups[nm]=S.groups[nm] or {models={}}
                    table.insert(S.groups[nm].models,obj)
                end
            elseif obj:IsA("BasePart") and obj.Parent==we then
                local nm=getEggName(obj)
                S.models[obj]={name=nm,root=obj}
                S.groups[nm]=S.groups[nm] or {models={}}
                table.insert(S.groups[nm].models,obj)
            end
        end
    end
    espDd.refresh(); autoDd.refresh()
end
local function scanEggs()
    local list={}
    local we=Workspace:FindFirstChild("WorldEggs"); if not we then return list end
    for _,obj in ipairs(we:GetDescendants()) do
        if obj:IsA("Model") and findRoot(obj) then
            local nm=getEggName(obj)
            if inSet(S.autoSelected,nm) then table.insert(list,{model=obj,name=nm}) end
        elseif obj:IsA("BasePart") and obj.Parent==we then
            local nm=getEggName(obj)
            if inSet(S.autoSelected,nm) then table.insert(list,{model=obj,name=nm}) end
        end
    end
    table.sort(list,function(a,b)
        if a.name==b.name then return tostring(a.model)<tostring(b.model) end
        return a.name<b.name
    end)
    return list
end

TPBtn.MouseButton1Click:Connect(function()
    local eggs=scanEggs(); if #eggs==0 then setStatus("no target"); return end
    local r=findRoot(eggs[1].model); if not r then setStatus("no root"); return end
    if tpTo(r.CFrame) then setStatus("TP "..eggs[1].name) else setStatus("TP fail") end
end)

local function runCycleOnce()
    local eggs=scanEggs(); if #eggs==0 then return false end
    for i,e in ipairs(eggs) do
        if S.killed or not S.running then break end
        local t=e.model
        if t and t.Parent then
            setStatus(string.format("%d/%d %s",i,#eggs,e.name))
            local r=findRoot(t)
            if r and tpTo(r.CFrame) then
                S.stats.tp+=1; task.wait(CFG.TP_DELAY)
                if holdCollect(t) then S.stats.ok+=1 else S.stats.fail+=1 end
                if S.baseCF then task.wait(CFG.RETURN_DELAY); if tpTo(S.baseCF) then S.stats.ret+=1; task.wait(CFG.RETURN_DELAY) end end
            else S.stats.fail+=1 end
            task.wait(CFG.CYCLE_GAP)
        end
    end
    return true
end
local function startAuto()
    if S.running then return end
    local h=getHRP(); if not h then setStatus("no hrp"); return end
    S.baseCF=h.CFrame; S.running=true; S.killed=false
    setStatus("running…")
    task.spawn(function()
        local iter=0
        while S.running and not S.killed do
            iter+=1
            if CFG.MAX_CYCLES>0 and iter>CFG.MAX_CYCLES then break end
            if not runCycleOnce() t