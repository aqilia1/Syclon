-- ===== HELPERS =====
local function setStatus(t) if StatusLabel.Parent then StatusLabel.Text=tostring(t) end end
local function getHRP() local c=LP.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function findRoot(m)
    if m:IsA("BasePart") then return m end
    return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart",true)
end
local function getEggName(m) local n=m:GetAttribute("EggName"); if typeof(n)=="string" and #n>0 then return n end return m.Name end
local function tpTo(cf) local h=getHRP(); if not h or not cf then return false end return (pcall(function() h.CFrame=CFrame.new(cf.Position+CFG.TP_OFFSET) end)) end
local function inSet(s,nm) if next(s)==nil then return true end return s[nm]==true end

-- ===== ESP =====
local function clearESP(m)
    local b=S.espBills[m]; if b then pcall(function() b:Remove() end); S.espBills[m]=nil end
    local h=S.espHighlights[m]; if h then pcall(function() h:Destroy() end); S.espHighlights[m]=nil end
end
local function buildESP(m)
    local r=findRoot(m); if not r then return end
    local nm=getEggName(m)
    if not S.espBills[m] and Drawing then
        local ok,bb=pcall(function()
            local d=Drawing.new("Text"); d.Text=nm; d.Size=13; d.Center=true; d.Outline=true
            d.Color=Color3.fromRGB(255,215,120); d.OutlineColor=Color3.fromRGB(0,0,0); d.Visible=false; return d
        end)
        if ok then S.espBills[m]=bb end
    end
    if not S.espHighlights[m] then
        local ok,h=pcall(function()
            local hh=Instance.new("Highlight")
            hh.FillColor=Color3.fromRGB(180,60,220); hh.FillTransparency=0.55
            hh.OutlineColor=Color3.fromRGB(255,220,255); hh.OutlineTransparency=0
            hh.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
            hh.Adornee=m; hh.Parent=parent; return hh
        end)
        if ok then S.espHighlights[m]=h end
    end
end
function refreshESP()
    for m in pairs(S.espBills) do if not S.esp or not m.Parent or not inSet(S.espSelected,getEggName(m)) then clearESP(m) end end
    for m in pairs(S.espHighlights) do if not S.esp or not m.Parent or not inSet(S.espSelected,getEggName(m)) then clearESP(m) end end
    if not S.esp then return end
    local we=Workspace:FindFirstChild("WorldEggs"); if not we then return end
    for _,obj in ipairs(we:GetDescendants()) do
        local isT=(obj:IsA("Model") and findRoot(obj)) or (obj:IsA("BasePart") and obj.Parent==we)
        if isT and inSet(S.espSelected,getEggName(obj)) then buildESP(obj) end
    end
end
